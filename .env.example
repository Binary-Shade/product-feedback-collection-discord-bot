# Discord bot token (from Discord Developer Portal -> Bot -> Token)
DISCORD_BOT_TOKEN=your-bot-token-here

# The Discord user ID(s) allowed to run admin commands (/setup, /register-app, /revoke-app)
# Comma separated if multiple.
ADMIN_DISCORD_IDS=123456789012345678

# Path to the shared SQLite database (used by both the API and the bot)
DATABASE_URL=sqlite:///./feedback.db

# Host/port for the FastAPI server (internal container port — host 8000 is left free)
API_HOST=0.0.0.0
API_PORT=8009

# DuckDNS auto-update (LinuxServer duckdns container updates IP every 5 min)
# Get token from duckdns.org -> your account page
DUCKDNS_TOKEN=your-duckdns-token-here

# Optional: rate limit — max feedback submissions per API key per minute
RATE_LIMIT_PER_MINUTE=10
